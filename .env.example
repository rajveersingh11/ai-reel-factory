# Environment configuration — copy to .env and fill in values
# NEVER commit the actual .env file

# --- Brand ---
DEFAULT_BRAND_ID=skyon

# --- Storage ---
STORAGE_ROOT=./storage
ASSET_ROOT=./assets

# --- FFmpeg ---
# Leave blank to use system PATH
FFMPEG_PATH=
FFPROBE_PATH=

# --- Piper TTS ---
PIPER_BINARY=piper
PIPER_MODELS_DIR=./assets/models/piper
DEFAULT_VOICE=en_US-lessac-medium

# --- faster-whisper ---
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# --- Ollama (Phase 3) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=0

# --- PostgreSQL (Phase 2) ---
DATABASE_URL=postgresql://reelfactory:reelfactory@localhost:5432/reelfactory

# --- Redis / Celery (Phase 2) ---
REDIS_URL=redis://localhost:6379/0
CELERY_CONCURRENCY=1

# --- Pixabay (Phase 4) ---
PIXABAY_API_KEY=

# --- Meta / Instagram (Phase 5) ---
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=

# --- QC Thresholds ---
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
TARGET_DURATION_MIN=55.0
TARGET_DURATION_MAX=62.0
TARGET_LOUDNESS_LUFS=-14.0
CAPTION_SAFE_ZONE_TOP=700
CAPTION_SAFE_ZONE_BOTTOM=1350

